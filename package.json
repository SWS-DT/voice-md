{
  "name": "obsidian-voice-md",
  "version": "1.5.1",
  "description": "Capture voice notes, meetings, and daily-note recordings as reliable Markdown using OpenAI",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "update-version": "node update-version.mjs"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "voice",
    "transcription",
    "gpt-4o-transcribe",
    "openai"
  ],
  "author": "Deniz Okcu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:DenizOkcu/voice-md.git"
  },
  "homepage": "https://github.com/DenizOkcu/voice-md#readme",
  "bugs": {
    "url": "https://github.com/DenizOkcu/voice-md/issues"
  },
  "dependencies": {
    "openai": "^7.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^17.8.0",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "overrides": {
    "brace-expansion": "^5.0.8"
  }
}
